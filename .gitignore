# Build outputs (copied out of the docker volume by build.sh)
/output-images/

# In-tree build dirs if anyone builds without docker (O=output)
/output/
/dl/

# Secrets: the real WiFi config stays local (never published). Ship only the
# wpa_supplicant.conf.example template; copy it to this path and fill it in.
/board/geniatech/atv329q/rootfs_overlay/etc/wpa_supplicant.conf

# macOS
.DS_Store

# Vendor partition backups (raw dumps, one directory per board).
# They hold PER-BOARD data (IMEI in modemst1/2, MAC and serial in params, radio
# calibration in persist) and proprietary firmware (50 MiB of MPSS in modem).
# They must never enter the repository.
/backup/
