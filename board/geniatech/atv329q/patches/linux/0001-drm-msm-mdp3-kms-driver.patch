+		sizes->surface_bpp = 24;
+		sizes->surface_depth = 24;
+	}
+
 	format = drm_mode_legacy_fb_format(sizes->surface_bpp, sizes->surface_depth);
 
 	DBG("create fbdev: %dx%d@%d (%dx%d)", sizes->surface_width,
diff --git a/drivers/gpu/drm/msm/msm_gem.c b/drivers/gpu/drm/msm/msm_gem.c
index b27abaa13..a741f6fe4 100644
--- a/drivers/gpu/drm/msm/msm_gem.c
+++ b/drivers/gpu/drm/msm/msm_gem.c
@@ -107,6 +107,10 @@ void msm_gem_vma_put(struct drm_gem_object *obj)
 #ifdef CONFIG_DRM_MSM_KMS
 	struct drm_exec exec;
 
+	/* KMS without display IOMMU: no kms->vm, hence no VMAs to put */
+	if (!priv->kms->vm)
+		return;
+
 	msm_gem_lock_vm_and_obj(&exec, obj, priv->kms->vm);
 	put_iova_spaces(obj, priv->kms->vm, true, "vma_put");
 	drm_exec_fini(&exec);     /* drop locks */
@@ -184,12 +188,96 @@ static void update_lru(struct drm_gem_object *obj)
 	mutex_unlock(&priv->lru.lock);
 }
 
+/*
+ * Backing for MSM_BO_CONTIG objects: physically contiguous DMA memory
+ * (CMA), for KMS without a display IOMMU (e.g. MDP3 on msm8909) where
+ * the scanout engine fetches from a flat device address.
+ */
+static struct page **get_pages_contig(struct drm_gem_object *obj)
+{
+	struct msm_gem_object *msm_obj = to_msm_bo(obj);
+	struct drm_device *dev = obj->dev;
+	size_t npages = obj->size >> PAGE_SHIFT;
+	struct sg_table *sgt;
+	struct page **p;
+	size_t i;
+	int ret;
+
+	msm_obj->dma_cookie = dma_alloc_attrs(dev->dev, obj->size,
+					      &msm_obj->paddr, GFP_KERNEL,
+					      DMA_ATTR_WRITE_COMBINE);
+	if (!msm_obj->dma_cookie) {
+		DRM_DEV_ERROR(dev->dev, "could not allocate %zu contig bytes\n",
+			      obj->size);
+		return ERR_PTR(-ENOMEM);
+	}
+
+	p = kvmalloc_objs(struct page *, npages);
+	sgt = kzalloc_obj(*sgt);
+	if (!p || !sgt) {
+		ret = -ENOMEM;
+		goto fail;
