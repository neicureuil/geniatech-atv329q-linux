+int msm_dsi_host_adopt(struct mipi_dsi_host *host);
+/* HACK(atv329q): lk2nd-style settle + poll for VIDEO_DONE after enable */
+void msm_dsi_host_wait_video(struct mipi_dsi_host *host);
