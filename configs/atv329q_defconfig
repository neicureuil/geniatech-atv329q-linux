# Buildroot defconfig for the Geniatech atv329q (Qualcomm MSM8909, Cortex-A7)
# Produces: kernel zImage + atv329q DTB, an ext4 rootfs (for the eMMC "system"
# partition, mmcblk0p22), and (via post-image.sh) an aboot boot.img + QCDT.

# Architecture: MSM8909 = quad Cortex-A7, ARMv7 32-bit, NEON/VFPv4, hard-float.
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y

# Toolchain (Buildroot internal, glibc for broad package compatibility).
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Init/system: BusyBox init, DHCP on eth0 (the internal ASIX RJ45 via the USB hub).
BR2_TARGET_GENERIC_HOSTNAME="atv329q"
BR2_TARGET_GENERIC_ISSUE="Geniatech atv329q - mainline Linux (Buildroot)"
BR2_TARGET_GENERIC_ROOT_PASSWD="alpine"
BR2_SYSTEM_DHCP="eth0"
BR2_SYSTEM_BIND_MOUNT_DEV_TYPE_DEVTMPFS=y

# Rootfs overlay (network, wpa_supplicant conf, screen DPMS helper).
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ATV329Q_PATH)/board/geniatech/atv329q/rootfs_overlay"

# Kernel: msm8916-mainline tree pinned at the BSP base + our atv329q patch,
# with our full .config, building zImage + the atv329q DTB.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/msm8916-mainline/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="ea3a5c52f8f62f6464b6cdc06b700f0704f1c04a"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_ATV329Q_PATH)/board/geniatech/atv329q/patches/linux"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_ATV329Q_PATH)/board/geniatech/atv329q/linux.config"
BR2_LINUX_KERNEL_ZIMAGE=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="qcom/qcom-msm8909-geniatech-atv329q"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Rootfs: ext4, sized to fill the eMMC "system" partition (1.2 GiB, mmcblk0p22).
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1200M"

# ccache: speeds up incremental rebuilds (kept on a persistent docker volume).
BR2_CCACHE=y
BR2_CCACHE_DIR="/ccache"

# e2fsprogs: mkfs.ext4/resize2fs on target (format the big userdata partition
# for /data, resize filesystems).
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
# no initramfs/cpio: rootfs is mounted from the eMMC partition (root=/dev/mmcblk0p22)
# BR2_TARGET_ROOTFS_CPIO is not set

# Networking / access.
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y

# --- Ecran / sortie HDMI (package atv329q-screen, ACTIVE par defaut) ---
# Chaine MDP3 -> DSI -> ADV7533 : le kernel (DRM/KMS + fbdev + fbcon) est deja
# dans linux.config ; le package fournit le userland (S15screen, getty tty0) et,
# quand il est DESACTIVE, le fragment linux-noscreen.config qui retire DRM/FB.
# Image HEADLESS : remplacer la ligne ci-dessous par
# "# BR2_PACKAGE_ATV329Q_SCREEN is not set" (ou build ponctuel :
# ./build.sh noscreen), puis ./build.sh kernel (le kernel change).
BR2_PACKAGE_ATV329Q_SCREEN=y

# Handy userland.
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y

# --- Bluetooth (WCNSS, meme coeur radio que le WiFi, via btqcomsmd) ---
# Cote kernel linux.config a deja BT=y / BT_QCOMSMD=y, plus RFCOMM, BNEP, HIDP,
# UHID et HIDRAW (claviers / souris / manettes Bluetooth).
# Cote userland: BlueZ 5 (bluetoothd + bluetoothctl + btmon + les outils hci*).
# bluez5_utils tire dbus et libglib2 tout seul; les init scripts S30dbus puis
# S40bluetoothd viennent avec les paquets. L'adaptateur hci0 n'apparait qu'une
# fois le remoteproc WCNSS demarre -> voir l'overlay S10wcnss.
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_MONITOR=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y

# --- SFTP ---
# dropbear annonce deja le subsystem sftp (DROPBEAR_SFTPSERVER=1, chemin
# /usr/libexec/sftp-server) mais ne fournit pas le binaire: on prend celui
# d'OpenSSH. post-build.sh supprime ensuite sshd et son init S50sshd pour qu'il
# ne se batte pas avec dropbear sur le port 22 (on garde le canal SSH eprouve).
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_SERVER=y
# BR2_PACKAGE_OPENSSH_CLIENT is not set
# BR2_PACKAGE_OPENSSH_KEY_UTILS is not set

# --- Docker (package docker-bin, ACTIVE par defaut) ---
# Binaires statiques officiels armhf (pas de compilation Go). Le package select
# iptables/ca-certificates/cgroupfs-mount/iproute2 et tire son fragment kernel
# linux-docker.config (namespaces, cgroups, overlayfs, netfilter).
# Image SANS docker : remplacer la ligne ci-dessous par
# "# BR2_PACKAGE_DOCKER_BIN is not set" (ou build ponctuel : ./build.sh
# nodocker), puis ./build.sh kernel (le kernel change).
BR2_PACKAGE_DOCKER_BIN=y

# --- NTP (chrony) ---
# Pas de RTC a pile : l'horloge demarre en 1970 -> TLS casse (docker pull :
# "certificate is not yet valid"). chrony discipline l'horloge en continu ;
# /etc/chrony.conf (overlay) autorise le step illimite (makestep 1.0 -1).
# S45timesync fait un premier calage synchrone (chronyd -q) avant dockerd (S60),
# puis le paquet demarre le demon via son S49chrony.
BR2_PACKAGE_CHRONY=y

# Nettoyage du rootfs avant la creation de l'image (voir post-build.sh).
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ATV329Q_PATH)/board/geniatech/atv329q/post-build.sh"

# Build the aboot boot.img + QCDT after the images are ready.
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_ATV329Q_PATH)/board/geniatech/atv329q/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS=""
