# Kernel fragment merged when the board option BR2_ATV329Q_SCREEN is OFF
# (see ../../../Config.in and ../../../external.mk).
#
# The atv329q display stack is MDP3 (display-controller@1a00000) -> MSM DSI +
# 28nm PHY -> ADV7533 DSI-to-HDMI bridge, driven by DRM/KMS with fbdev
# emulation for the framebuffer console. Dropping DRM takes the whole chain out
# (every DRM_* symbol depends on it), and dropping FB/fbcon/logo removes what
# was only there to paint that console -- Buildroot re-runs olddefconfig after
# the merge, so the dependent symbols follow.
#
# The kernel *patches* (MDP3 driver, DSI, ADV7533, MDSS clock, device tree) stay
# applied either way: they are the board's source of truth. This only stops the
# display from being built.
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_LOGO is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
